ENTORNO=desarrollo
ORIGENES_PERMITIDOS=http://127.0.0.1:8080,http://localhost:8080
CONTRASENA_APLICACION=
SECRETO_FIRMA_SESIONES=cambia-esto-por-un-secreto-largo-y-aleatorio
HORAS_DURACION_SESION=168
DATABASE_URL=sqlite:///./datos-locales/zhy-companion.db
# Modelos LiteLLM, en orden de prioridad y separados por coma.
# Recomendado: OpenRouter primero + uno o más proveedores directos como respaldo.
# Usa IDs VIGENTES consultados al proveedor cuando despliegues.
# Ejemplos de formato: openrouter/<modelo>, anthropic/<modelo>, deepseek/<modelo>, ollama/<modelo>
MODELOS_LITELLM_PRIORIDAD=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=
MAX_SOLICITUDES_POR_MINUTO=24
# Mapeos opcionales para que el selector de la app priorice una familia concreta.
MODELO_CLAUDE=
MODELO_QWEN=
MODELO_DEEPSEEK=
MODELO_MINIMAX=
MODELO_OLLAMA=
